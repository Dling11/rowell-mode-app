# Local, Vercel Preview and Production must use separate credentials/resources.
MONGODB_URI=
MONGODB_DB=rowell_hub
# Use localhost locally for passkeys; production requires your stable HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Random private first-owner setup code; never publish it or reuse as a password.
OWNER_SETUP_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed authenticated image-only preset. The app verifies a 5 MiB limit.
# Use a separate folder/preset per environment; media:setup verifies folder mode.
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=rowell-hub-local
CLOUDINARY_FOLDER_MODE=dynamic
# Optional GitHub read-only token to increase public release API rate limits.
GITHUB_RELEASE_TOKEN=
# Emergency override: normal, downloads-paused, maintenance. Cannot loosen DB policy.
SITE_MODE=
